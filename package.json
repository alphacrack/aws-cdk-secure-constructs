{
  "name": "aws-cdk-secure-constructs",
  "version": "0.1.0",
  "description": "Secure-by-default AWS CDK constructs with property injection and CIS-verified compliance reports",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    ".jsii"
  ],
  "stability": "experimental",
  "scripts": {
    "build": "jsii",
    "build:watch": "jsii --watch",
    "package": "jsii-pacmak",
    "api-diff": "jsii-diff npm:$npm_package_name",
    "watch": "jsii --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:local-build": "bash scripts/test-local-build.sh",
    "release": "bash scripts/release.sh",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"examples/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"examples/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"examples/*.ts\" \"**/*.{json,md}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"examples/*.ts\" \"**/*.{json,md}\"",
    "prepublishOnly": "npm run build",
    "prepare": "husky",
    "pre-commit": "lint-staged",
    "clean": "rm -rf lib dist coverage .jsii tsconfig.tsbuildinfo"
  },
  "keywords": [
    "aws",
    "cdk",
    "constructs",
    "security",
    "blueprints",
    "infrastructure",
    "typescript"
  ],
  "author": {
    "name": "alphacrack",
    "url": "https://github.com/alphacrack"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/alphacrack/aws-cdk-secure-constructs.git"
  },
  "bugs": {
    "url": "https://github.com/alphacrack/aws-cdk-secure-constructs/issues"
  },
  "homepage": "https://github.com/alphacrack/aws-cdk-secure-constructs#readme",
  "jsii": {
    "outdir": "dist",
    "versionFormat": "short",
    "targets": {
      "python": {
        "distName": "aws-cdk-secure-constructs",
        "module": "aws_cdk_secure_constructs"
      }
    },
    "tsc": {
      "outDir": "lib",
      "rootDir": "src"
    },
    "excludeTypescript": [
      "examples",
      "test"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.8.10",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "aws-cdk": "^2.1134.0",
    "aws-cdk-lib": "2.263.0",
    "constructs": "10.7.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jest": "^29.16.0",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jsii": "^6.0.7",
    "jsii-diff": "^1.135.0",
    "jsii-pacmak": "^1.135.0",
    "lint-staged": "^17.3.0",
    "prettier": "^3.8.4",
    "ts-jest": "^29.4.12",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.60.1"
  },
  "peerDependencies": {
    "aws-cdk-lib": "^2.196.0",
    "constructs": "^10.3.0"
  },
  "bundledDependencies": [],
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
